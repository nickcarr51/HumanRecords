# Copy to .env.local for local development.

# Supabase — client-safe (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Cloudflare R2 — server-only (signing happens server-side; never NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=humanrecords-media-dev
R2_ENDPOINT=
