# Copy to .env.local for local development.
# Cloudflare R2 variables will be added in a follow-up spec/plan once that
# integration work starts.

# Supabase — client-safe (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
