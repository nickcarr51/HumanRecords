# Copy to .env.local for local development.

# Supabase — client-safe (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional. Feed releases per page (default 20). Use a small number locally to test paging.
FEED_PAGE_SIZE=

# Cloudflare R2 — server-only (signing happens server-side; never NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=humanrecords-media-local
R2_ENDPOINT=

# scripts/invite-users.mts reads SUPABASE_URL + SUPABASE_SECRET_KEY. For the
# hosted develop project, put them in .env.develop.local (gitignored) and run:
#   node --env-file=.env.develop.local scripts/invite-users.mts --yes

# Base URL used to build invite links (/login?email=&invite=). Server-only.
# Local: http://127.0.0.1:3000 · each Vercel environment: its own domain.
SITE_URL=

# Sentry (free plan only; errors only). The DSN is client-safe.
NEXT_PUBLIC_SENTRY_DSN=
# Tags Sentry events: local | develop | production
NEXT_PUBLIC_APP_ENV=local
# Source-map upload at build time (Vercel only; leave blank locally)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Which environment differs in what ---------------------------------
# Local (.env.local):  Supabase keys from `yarn supabase status`; R2_BUCKET_NAME=
#                      humanrecords-media-local (its own token); SITE_URL=http://127.0.0.1:3000;
#                      NEXT_PUBLIC_APP_ENV=local; Sentry vars blank.
# Develop (Vercel Preview, develop branch): develop Supabase project; R2_BUCKET_NAME=
#                      humanrecords-media-dev + dev-only token; SITE_URL=develop domain;
#                      NEXT_PUBLIC_APP_ENV=develop.
# Production (Vercel Production): prod Supabase project; R2_BUCKET_NAME=
#                      humanrecords-media-prod + prod-only token; SITE_URL=prod domain;
#                      NEXT_PUBLIC_APP_ENV=production.
# Same everywhere: R2_ACCOUNT_ID / R2_ENDPOINT, Sentry DSN and org/project.
# Secrets are pasted into the Vercel/GitHub dashboards by the owner, never committed.
# CI uses fake values (see .github/workflows/ci.yml).
